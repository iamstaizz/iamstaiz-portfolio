generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TagType {
  STACK
  TOPIC
}

enum SkillCategory {
  FRONTEND
  BACKEND
  DATABASE
  TOOLS
  OTHER
}

model Project {
  id            String   @id @default(cuid())
  slug          String   @unique
  titleEn       String
  titleUk       String
  summaryEn     String
  summaryUk     String
  descriptionEn String?  @db.Text
  descriptionUk String?  @db.Text
  coverImage    String?
  images        String[]
  liveUrl       String?
  repoUrl       String?
  year          Int?
  featured      Boolean  @default(false)
  published     Boolean  @default(false)
  order         Int      @default(0)
  tags          Tag[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([published, order])
}

model Tag {
  id       String    @id @default(cuid())
  slug     String    @unique
  name     String
  type     TagType
  projects Project[]

  @@index([type])
}

model Skill {
  id       String        @id @default(cuid())
  name     String
  category SkillCategory
  order    Int           @default(0)

  @@index([category, order])
}

model Message {
  id        String   @id @default(cuid())
  name      String
  email     String
  body      String   @db.Text
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([read, createdAt])
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}
